  subject           String?          @db.VarChar
  description       String?
  issuedDate        DateTime?        @db.Date
  issuedBy          String?          @db.VarChar
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  manageEmployee    ManageEmployee?  @relation(fields: [employeeID], references: [id], onDelete: SetNull)

  @@index([employeeID])
}

// ==================== FACTUAL TABLES ====================

model FactualWorkShift {
  id                  Int                   @id @default(autoincrement())
  serviceProviderID   Int?
  companyID           Int?
  branchesID          Int?
  workShiftName       String?               @db.VarChar
  isActive            String?               @db.VarChar
  workShiftType       String?               @db.VarChar
  isFlexible          Boolean?              @default(false)
  isRotating          Boolean?              @default(false)
  breakTimeMin        Int?                  @default(0)
  createdAt           DateTime              @default(now())
  factualWorkShiftDay FactualWorkShiftDay[]
  factualRosterDay    FactualRosterDay[]
  empFactualWorkShift EmpFactualWorkShift[] @relation("EmpFactualWorkShiftLink")
}

model FactualWorkShiftDay {
  id                 Int               @id @default(autoincrement())
  factualWorkShiftID Int?
  weekDay            String?           @db.VarChar
  shiftType          String?           @db.VarChar
  weeklyOff          Boolean?
  startTime          String?
  endTime            String?
  breakStart         String?
  breakEnd           String?
  totalMinutes       Int?
  factualWorkShift   FactualWorkShift?  @relation(fields: [factualWorkShiftID], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model FactualAttendancePolicy {
  id                                     Int      @id @default(autoincrement())
  serviceProviderID                      Int?
  companyID                              Int?
  branchesID                             Int?
  attendancePolicyName                   String?  @db.VarChar
  workingHoursType                       String?  @db.VarChar
  checkin_begin_before_min               Int?
  checkout_end_after_min                 Int?
  checkin_grace_time_min                 Int?
  earlyCheckoutBeforeEndMin              Int?
  min_work_hours_half_day_min            Int?
  max_late_check_in_time                 Int?
  markAs                                 String?
  lateMarkCount                          String?
  allow_self_mark_attendance             Boolean? @default(false)
  allow_manager_update_ot                Boolean? @default(false)
  max_ot_hours_per_day_min               Int?
  checkoutGracePeriodForOvertimeTrimming Int?     @default(0)
  breakTimeForOT                         Int?     @default(0)
  otMealApply                            Boolean? @default(false)
  maxOvertimeHrs                         Int?     @default(0)
  minOvertimeHrs                         Int?     @default(0)
  countWorkhoursInMinutes                Boolean? @default(false)
  overtimeApplicable                     Boolean? @default(false)
  overtimeTrimmingApply                  Boolean? @default(false)
  minsForOTMealToken                     Int?     @default(0)
  minsForBreakTimeForMeal                Int?     @default(0)
  weekoffCompulsory                      Boolean? @default(false)
  leaveAroundHolidayCounted              Boolean? @default(false)
  lateMarkMarkAs                         String?
  lateMarkMarkCount                      String?
  maxLateCheckinMarkAs                   String?
  trimPreshiftMin                        Int?     @default(0)
  trimPostshiftMin                       Int?     @default(0)
  createdAt                              DateTime @default(now())
  empFactualAttendancePolicy             EmpFactualAttendancePolicy[] @relation("EmpFactualAttendancePolicyLink")
}

model EmpFactualWorkShift {
  id                    Int              @id @default(autoincrement())
  manageEmployeeID      Int
  factualWorkShiftID    Int
  effectFrom            String?          @db.VarChar
  manageEmployee        ManageEmployee   @relation(fields: [manageEmployeeID], references: [id], onDelete: Cascade)
  factualWorkShift      FactualWorkShift @relation("EmpFactualWorkShiftLink", fields: [factualWorkShiftID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([manageEmployeeID])
}

model EmpFactualAttendancePolicy {
  id                        Int                     @id @default(autoincrement())
  manageEmployeeID          Int
  factualAttendancePolicyID Int
  effectFrom                String?                 @db.VarChar
  manageEmployee            ManageEmployee          @relation(fields: [manageEmployeeID], references: [id], onDelete: Cascade)
  factualAttendancePolicy   FactualAttendancePolicy @relation("EmpFactualAttendancePolicyLink", fields: [factualAttendancePolicyID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([manageEmployeeID])
}

model FactualRoster {
  id                Int                     @id @default(autoincrement())
  serviceProviderID Int
  companyID         Int
  branchesID        Int
  departmentID      Int
  designationID     Int?
  fromDate          DateTime
  toDate            DateTime
  rosterPeriod      String
  status            String                  @default("DRAFT")
  createdBy         Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  employees         FactualRosterEmployee[]
}

model FactualRosterEmployee {
  id              Int                @id @default(autoincrement())
  factualRosterID Int
  employeeID      Int
  days            FactualRosterDay[]
  factualRoster   FactualRoster      @relation(fields: [factualRosterID], references: [id], onDelete: Cascade)

  @@unique([factualRosterID, employeeID])
}

model FactualRosterDay {
  id                      Int                   @id @default(autoincrement())
  factualRosterEmployeeID Int
  workDate                DateTime
  factualWorkShiftID      Int?
  dayType                 String
  leaveType               String?
  isLocked                Boolean               @default(false)
  factualRosterEmployee   FactualRosterEmployee @relation(fields: [factualRosterEmployeeID], references: [id], onDelete: Cascade)
  factualWorkShift        FactualWorkShift?     @relation(fields: [factualWorkShiftID], references: [id])

  @@unique([factualRosterEmployeeID, workDate])
}

model AttendanceLocation {
  id                Int             @id @default(autoincrement())
  employeeId        Int
  checkType         String          @db.VarChar(20)
  latitude          Float
  longitude         Float
  accuracy          Float?
  ipAddress         String?         @db.VarChar(64)
  deviceType        String?         @db.VarChar(64)
  browser           String?         @db.VarChar(128)
  operatingSystem   String?         @db.VarChar(128)
  userAgent         String?         @db.Text
  companyID         Int?
  branchesID        Int?
  serviceProviderID Int?
  checkinTime       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employee          ManageEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([checkinTime])
  @@index([checkType])
  @@map("attendance_locations")
}
