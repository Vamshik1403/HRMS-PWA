model EmployeeFieldHistory {
  id               Int            @id @default(autoincrement())
  employeeId       Int
  fieldName        String         @db.VarChar
  oldValue         String?        @db.VarChar
  newValue         String?        @db.VarChar
  oldLabel         String?        @db.VarChar
  newLabel         String?        @db.VarChar
  changedAt        DateTime       @default(now())
  employee         ManageEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([fieldName])
}

model EmployeeLink {
  id               Int            @id @default(autoincrement())
  employeeId       Int
  linkedEmployeeId Int
  employee         ManageEmployee @relation("EmployeeLinks", fields: [employeeId], references: [id], onDelete: Cascade)
  linkedEmployee   ManageEmployee @relation("LinkedToEmployee", fields: [linkedEmployeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, linkedEmployeeId])
  @@index([employeeId])
  @@index([linkedEmployeeId])
}

model EmployeeTermination {
  id                Int            @id @default(autoincrement())
  employeeId        Int
  serviceProviderID Int
  companyID         Int
  branchesID        Int
  exitType          ExitType
  exitStatus        ExitStatus     @default(DRAFT)
  reasonCategory    String?
  reasonNote        String?
  noticeDays        Int?
  noticeStartDate   DateTime?
  lastWorkingDay    DateTime?
  resignationDate   DateTime?
  approvalDate      DateTime?
  disableLoginOn    DateTime?
  isRehireEligible  Boolean        @default(true)
  createdByUserId   Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  employee          ManageEmployee @relation(fields: [employeeId], references: [id])

  @@index([serviceProviderID, companyID, branchesID])
  @@index([employeeId, exitType])
}

